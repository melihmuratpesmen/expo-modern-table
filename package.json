{
  "name": "expo-modern-table",
  "version": "0.1.0",
  "description": "A modern, feature-rich data table for Expo and React Native — sorting, filtering, sticky columns, row/column reorder, theming, and more.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "react-native": "src/index.ts",
  "source": "src/index.ts",
  "files": [
    "src",
    "LICENSE",
    "README.md",
    "docs"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "echo \"No linter configured yet\"",
    "example": "npm --prefix example start",
    "example:go": "npm --prefix example run start:go -- --port 8082",
    "example:tunnel": "npm --prefix example run tunnel",
    "example:ios": "npm --prefix example run ios",
    "example:android": "npm --prefix example run android",
    "example:web": "npm --prefix example run web"
  },
  "keywords": [
    "expo",
    "react-native",
    "table",
    "datatable",
    "flash-list",
    "sortable",
    "filterable",
    "sticky-columns"
  ],
  "author": "melihmuratpesmen",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/melihmuratpesmen/expo-modern-table.git"
  },
  "bugs": {
    "url": "https://github.com/melihmuratpesmen/expo-modern-table/issues"
  },
  "homepage": "https://github.com/melihmuratpesmen/expo-modern-table#readme",
  "peerDependencies": {
    "@shopify/flash-list": ">=1.6.0",
    "expo-screen-orientation": ">=7.0.0",
    "lucide-react-native": ">=0.300.0",
    "react": ">=18.0.0",
    "react-native": ">=0.73.0",
    "react-native-gesture-handler": ">=2.14.0",
    "react-native-reanimated": ">=3.6.0",
    "react-native-svg": ">=14.0.0"
  },
  "peerDependenciesMeta": {
    "expo-screen-orientation": {
      "optional": true
    }
  },
  "devDependencies": {
    "@shopify/flash-list": "^2.0.2",
    "@types/react": "~19.1.0",
    "lucide-react-native": "^0.556.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-svg": "15.12.0",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "react-native-svg": "15.12.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
